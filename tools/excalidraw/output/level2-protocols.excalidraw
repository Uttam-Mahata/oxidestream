      "boundElements": [],
      "updated": 1787764955974,
      "link": null,
      "locked": false,
      "text": "Pull-based (default):\n  Get(Ticket) → RecordBatch stream\n  Index-based byte range seeks\n\nPush-based (Phase 3):\n  DoPut → Merger Node\n  Consolidated shuffle files\n\nESS: Isolated flight thread",
      "fontSize": 11,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "Pull-based (default):\n  Get(Ticket) → RecordBatch stream\n  Index-based byte range seeks\n\nPush-based (Phase 3):\n  DoPut → Merger Node\n  Consolidated shuffle files\n\nESS: Isolated flight thread",
      "autoResize": true,
      "lineHeight": 1.25
    },
